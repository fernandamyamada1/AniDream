ninja_required_version = 1.3
cxx = c++
nvcc = /home/hpc/anaconda3/envs/dream/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=_raymarchingrgb -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/TH -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/THC -isystem /home/hpc/anaconda3/envs/dream/include -isystem /home/hpc/anaconda3/envs/dream/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=_raymarchingrgb -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/TH -isystem /home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/include/THC -isystem /home/hpc/anaconda3/envs/dream/include -isystem /home/hpc/anaconda3/envs/dream/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 --compiler-options '-fPIC' -O3 -std=c++17 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/hpc/anaconda3/envs/dream/lib/python3.11/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/hpc/anaconda3/envs/dream/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build raymarching.cuda.o: cuda_compile /home/hpc/fernanda/DreamWaltz/core/nerf/raymarching/rgb/src/raymarching.cu
build bindings.o: compile /home/hpc/fernanda/DreamWaltz/core/nerf/raymarching/rgb/src/bindings.cpp



build _raymarchingrgb.so: link raymarching.cuda.o bindings.o

default _raymarchingrgb.so
